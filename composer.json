{
    "name": "rucin96/microservices-connection",
    "description": "Asynchronous communication package for microservices",
    "type": "library",
    "version": "1.0.0",
    "require": {
        "php": ">=8.2",
        "symfony/messenger": "^7.3",
        "symfony/amqp-messenger": "^7.3"
    },
    "require-dev": {
      "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Vehis\\Msc\\": "src/",
            "Tests\\Vehis\\Msc\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Marcin Ruciński",
            "email": "mrucinski@vehis.pl"
        }
    ],
    "minimum-stability": "stable"
}
